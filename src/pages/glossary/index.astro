---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import Reveal from '../../components/Reveal.astro';
import { GLOSSARY, GLOSSARY_CATEGORIES } from '../../data/glossary.js';
import { site } from '../../data/site';

type Term = {
  slug: string;
  term: string;
  category: string;
  shortDefinition: string;
};

const terms = GLOSSARY as Term[];
const categories = GLOSSARY_CATEGORIES as string[];

const byCategory = categories.map((category) => ({
  category,
  items: terms
    .filter((t) => t.category === category)
    .sort((a, b) => a.term.localeCompare(b.term)),
}));

/**
 * DefinedTermSet ties all 77 terms together as one glossary rather than 77
 * unrelated pages, which is what lets a search engine treat the set as a
 * reference work.
 */
const schema = [
  {
    '@type': 'DefinedTermSet',
    '@id': `${site.url}/glossary#set`,
    name: 'Gobiya SEO & AI Search Glossary',
    description:
      'Plain-English definitions of the SEO, AI search, web, and paid media terms that come up in our work.',
    hasDefinedTerm: terms.map((t) => ({
      '@type': 'DefinedTerm',
      name: t.term,
      description: t.shortDefinition,
      url: new URL(`/glossary/${t.slug}`, site.url).href,
    })),
  },
];
---

<Base
  title="Glossary — SEO, AI Search & PPC Terms"
  description={`Plain-English definitions of ${terms.length} SEO, AI search, web, and paid media terms — what each one means and why it matters to your rankings.`}
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Glossary', href: '/glossary' }]}
  schema={schema}
>
  <PageIntro
    variant="crest"
    eyebrow={`${terms.length} terms`}
    title="The words, without the hand-waving."
    lede="Plain-English definitions of the terms that come up in search work — what each one actually means, and whether it deserves your attention."
  />

  <section class="glossary">
    <div class="shell">
      <nav class="jump" aria-label="Jump to category">
        {byCategory.map(({ category, items }) => (
          <a href={`#${category.toLowerCase()}`} class="jump-link">
            {category} <span class="jump-count tnum">{items.length}</span>
          </a>
        ))}
      </nav>

      {byCategory.map(({ category, items }) => (
        <section class="cat" id={category.toLowerCase()}>
          <h2 class="cat-title">{category}</h2>
          <ul class="term-grid">
            {items.map((term, i) => (
              <Reveal as="li" delay={Math.min(i, 6) * 40} class="term">
                <a href={`/glossary/${term.slug}`} class="term-link">
                  <h3 class="term-name">{term.term}</h3>
                  <p class="term-def">{term.shortDefinition}</p>
                </a>
              </Reveal>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>
</Base>

<style>
  .glossary {
    padding-block: var(--space-3xl);
  }

  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    padding-block-end: var(--space-xl);
    border-block-end: var(--rule-hairline) solid var(--color-rule);
  }

  .jump-link {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-xs);
    padding: var(--space-2xs) var(--space-sm);
    border: var(--rule-hairline) solid var(--color-rule);
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
  }

  .jump-link:hover {
    border-color: var(--color-accent);
  }

  .jump-count {
    font-family: var(--font-outlier);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .cat {
    padding-block-start: var(--space-2xl);
    scroll-margin-block-start: var(--space-2xl);
  }

  .cat-title {
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .term-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-sm);
    margin-block-start: var(--space-lg);
  }

  .term-link {
    display: block;
    height: 100%;
    padding: var(--space-md) var(--space-lg);
    border: var(--rule-hairline) solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-paper-2);
    transition: border-color var(--dur-short) var(--ease-out);
  }

  .term-link:hover {
    border-color: var(--color-accent);
  }

  .term-name {
    font-size: var(--text-md);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .term-def {
    margin-block-start: var(--space-xs);
    font-size: var(--text-sm);
    color: var(--color-neutral);
  }

  @media (width >= 48rem) {
    .term-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width >= 72rem) {
    .term-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
