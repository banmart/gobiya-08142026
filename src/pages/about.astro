---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import Reveal from '../components/Reveal.astro';
import Chip from '../components/Chip.astro';
import Method from '../components/Method.astro';
import Testimonials from '../components/Testimonials.astro';
import { brand, site } from '../data/site';

const principles = [
  {
    index: '01',
    title: 'Evidence before opinion',
    body: 'Every engagement opens with a reproducible audit — server logs, render diffs, index coverage, citation traces. You get the raw evidence, not a scorecard with a colour on it. If we cannot show you where a claim came from, we do not make it.',
  },
  {
    index: '02',
    title: 'Repair before growth',
    body: 'There is no point publishing into a site the crawler cannot read. Structural faults get closed first; content and authority work lands on a foundation that will hold it. This order is not negotiable, and it is why the first month rarely looks like marketing.',
  },
  {
    index: '03',
    title: 'Numbers with a source',
    body: 'Every figure we publish traces back to a client-approved case study or a Search Console export. We do not print round numbers we cannot defend, and we would rather leave a gap than fill it with something plausible.',
  },
  {
    index: '04',
    title: 'Month to month',
    body: 'No long-term lock-in contracts. If the work stops being worth it, you should be able to stop buying it — an agency that needs a twelve-month contract to keep a client is telling you something.',
  },
];

const schema = [
  {
    '@type': 'AboutPage',
    name: `About ${brand.name}`,
    mainEntity: { '@id': `${site.url}/#organization` },
  },
];
---

<Base
  title="About — A Los Angeles Search Practice"
  description="Gobiya is a Los Angeles search practice working from primary evidence — logs, headers, render output — rather than dashboard summaries. Here is how we work and why."
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'About', href: '/about' }]}
  schema={schema}
>
  <PageIntro
    variant="warp"
    eyebrow={`Est. ${brand.founded} · ${brand.locality}, ${brand.region}`}
    title="Evidence beats opinion, every time."
    lede="Gobiya exists because most search advice is asserted rather than demonstrated. We work from logs, headers, and render output instead — and we show you the working."
  />

  <section class="intro">
    <div class="shell">
      <Reveal>
        <p class="intro-text">
          Most of what gets sold as SEO is a summary of a summary: a tool reads
          your site, a dashboard reads the tool, and a report reads the
          dashboard. By the time it reaches you, the thing that actually
          happened — a crawler got a 500, a render dropped the main content, a
          canonical pointed at a redirect — has been averaged away into a score.
        </p>
        <p class="intro-text">
          We start at the other end. Server logs show what was actually
          requested and what actually came back. A render diff shows what the
          crawler saw against what a browser sees. Index coverage history shows
          when a page stopped being eligible and what changed that week. From
          there the repair list writes itself, in priority order, with an
          estimate against each line.
        </p>
        <p class="intro-text">
          It is unglamorous work and it does not photograph well. It is also the
          only kind that survives an algorithm update.
        </p>
      </Reveal>
    </div>
  </section>

  <section class="principles band-void">
    <div class="grain" aria-hidden="true"></div>
    <div class="shell">
      <Reveal>
        <h2 class="principles-title">How we work</h2>
      </Reveal>

      <ol class="principles-grid">
        {principles.map((principle, i) => (
          <Reveal as="li" delay={i * 70} class="principle">
            <span class="principle-index tnum">{principle.index}</span>
            <h3 class="principle-name">{principle.title}</h3>
            <p class="principle-body">{principle.body}</p>
          </Reveal>
        ))}
      </ol>
    </div>
  </section>

  <Method />

  <Testimonials />

  <section class="about-foot">
    <div class="shell">
      <Reveal class="about-foot-inner">
        <div>
          <h2 class="about-foot-title">Where to find us</h2>
          <p class="about-foot-line">{brand.location}</p>
          <p class="about-foot-line">{brand.hours}</p>
          <p class="about-foot-line">
            <a href={`mailto:${brand.email}`}>{brand.email}</a>
            <span aria-hidden="true"> · </span>
            <a href={`tel:${brand.phone}`}>{brand.phoneDisplay}</a>
          </p>
        </div>
        <Chip href="/contact" variant="solid">Book a diagnostic</Chip>
      </Reveal>
    </div>
  </section>
</Base>

<style>
  .intro {
    padding-block: var(--space-3xl);
  }

  .intro-text {
    max-width: 68ch;
    color: var(--color-neutral);
  }

  .intro-text + .intro-text {
    margin-block-start: var(--space-md);
  }

  .principles {
    position: relative;
    isolation: isolate;
    padding-block: var(--space-3xl);
  }

  .principles-title {
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .principles-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xl);
    margin-block-start: var(--space-xl);
  }

  .principle-index {
    font-family: var(--font-outlier);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    color: var(--color-void-muted);
  }

  .principle-name {
    margin-block-start: var(--space-sm);
    font-size: var(--text-md);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .principle-body {
    margin-block-start: var(--space-sm);
    font-size: var(--text-sm);
    color: var(--color-void-neutral);
    max-width: 46ch;
  }

  .about-foot {
    padding-block: var(--space-3xl);
    border-block-start: var(--rule-hairline) solid var(--color-rule);
  }

  .about-foot-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-xl);
  }

  .about-foot-title {
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: -0.03em;
    margin-block-end: var(--space-md);
  }

  .about-foot-line {
    font-size: var(--text-sm);
    color: var(--color-neutral);
  }

  .about-foot-line a {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  @media (width >= 48rem) {
    .principles-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width >= 72rem) {
    .principles-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
