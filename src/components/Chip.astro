---
import styles from './Chip.module.css';

type Variant = 'outline' | 'solid' | 'onVoid' | 'onVoidSolid';

interface Props {
  href: string;
  variant?: Variant;
  class?: string;
}

const { href, variant = 'outline', class: className } = Astro.props;

const VARIANT_CLASS: Record<Variant, string | undefined> = {
  outline: undefined,
  solid: styles.solid,
  onVoid: styles.onVoid,
  onVoidSolid: styles.onVoidSolid,
};

const cls = [styles.chip, VARIANT_CLASS[variant], className].filter(Boolean).join(' ');
---

<a href={href} class={cls}>
  <slot />
  <span class={styles.arrow} aria-hidden="true">
    <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M2.5 6h7M6.5 3l3 3-3 3" stroke-linecap="square" />
    </svg>
  </span>
</a>
