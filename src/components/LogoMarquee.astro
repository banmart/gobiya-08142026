---
import { clientLogos } from '../data/content';
import styles from './LogoMarquee.module.css';

/** Sector labels, not client wordmarks. The named work lives on /work. */
---

<section class={styles.wall} aria-label="Sectors we work in">
  <div class="shell">
    <p class:list={['label', styles.caption]}>Sectors we work in</p>
  </div>
  <div class={styles.viewport}>
    <div class={styles.track}>
      {[0, 1].map(() => (
        <div class={styles.group} aria-hidden="true">
          {clientLogos.map((name) => <span class={styles.item}>{name}</span>)}
        </div>
      ))}
    </div>
  </div>
  {/* accessible equivalent of the duplicated visual track */}
  <ul class="sr-only">
    {clientLogos.map((name) => <li>{name}</li>)}
  </ul>
</section>
