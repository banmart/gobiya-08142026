---
import Reveal from './Reveal.astro';
import SectionHead from './SectionHead.astro';

/**
 * Answers run 40–70 words and lead with the answer, which is the shape AI
 * answer engines quote from. Marked up as <details> so every answer is in the
 * HTML and readable with scripting off — an accordion that mounts its panels
 * on click is invisible to anything that does not execute the click.
 */
interface Props {
  items: { q: string; a: string }[];
  lead?: string;
  trail?: string;
}

const {
  items,
  lead = 'The questions we get asked before the first call.',
  trail = 'Answered here so you do not have to ask them.',
} = Astro.props;
---

<section class="faq" aria-labelledby="faq-title">
  <div class="shell">
    <SectionHead id="faq-title" lead={lead} trail={trail} />

    <div class="faq-list">
      {items.map((item, i) => (
        <Reveal delay={Math.min(i, 3) * 60}>
          <details class="faq-item" name="faq">
            <summary class="faq-q">
              <h3>{item.q}</h3>
              <span class="faq-marker" aria-hidden="true"></span>
            </summary>
            <div class="faq-a"><p>{item.a}</p></div>
          </details>
        </Reveal>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    padding-block: var(--space-3xl);
  }

  .faq-list {
    margin-block-start: var(--space-2xl);
    border-block-start: var(--rule-hairline) solid var(--color-rule);
  }

  .faq-item {
    border-block-end: var(--rule-hairline) solid var(--color-rule);
  }

  .faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    padding-block: var(--space-lg);
    cursor: pointer;
    list-style: none;
    min-height: 2.75rem;
  }

  .faq-q::-webkit-details-marker {
    display: none;
  }

  .faq-q h3 {
    font-size: var(--text-md);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.3;
    max-width: 52ch;
  }

  /* A drawn cross that rotates to a minus — no icon font, no dependency. */
  .faq-marker {
    position: relative;
    flex: none;
    width: 0.75rem;
    height: 0.75rem;
    transition: transform var(--dur-mid) var(--ease-out);
  }

  .faq-marker::before,
  .faq-marker::after {
    content: "";
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 0;
    width: 100%;
    height: 1px;
    background: var(--color-neutral);
  }

  .faq-marker::after {
    transform: rotate(90deg);
    transition: opacity var(--dur-short) var(--ease-out);
  }

  .faq-item[open] .faq-marker {
    transform: rotate(180deg);
  }

  .faq-item[open] .faq-marker::after {
    opacity: 0;
  }

  .faq-a {
    padding-block-end: var(--space-lg);
    max-width: 68ch;
    color: var(--color-neutral);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-marker {
      transition: none;
    }
  }
</style>
