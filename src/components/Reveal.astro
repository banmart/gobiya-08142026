---
/**
 * Motion primitive 1 of 3 — `reveal`.
 *
 * One orchestrated entrance per section, then the content is simply there.
 *
 * The React version shipped an IntersectionObserver *per instance*. Here the
 * element only declares its intent; a single shared observer in Base.astro
 * drives every [data-reveal] on the page. Same behaviour, one observer, and no
 * component runtime at all.
 */
interface Props {
  as?: string;
  /** stagger, in ms — keep under 240 total across a group */
  delay?: number;
  class?: string;
  /**
   * Opt out of the reveal entirely, for anything above the fold.
   *
   * The reveal starts at opacity 0, and Chrome does not treat an opacity-0
   * element as painted — so gating the hero behind it meant Largest
   * Contentful Paint could not fire until the observer script had run. On a
   * throttled phone that was most of the measured LCP. Content in the first
   * viewport renders immediately; the animation is for content you scroll to.
   */
  immediate?: boolean;
}

const { as: Tag = 'div', delay = 0, class: className, immediate = false } = Astro.props;
---

{immediate ? (
  <Tag class={className}><slot /></Tag>
) : (
  <Tag
    class={className}
    data-reveal
    data-shown="false"
    style={delay ? `--reveal-delay: ${delay}ms` : undefined}
  >
    <slot />
  </Tag>
)}
