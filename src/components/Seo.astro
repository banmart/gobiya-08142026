---
import { brand, site } from '../data/site';

/**
 * Every <head> signal that search engines and AI answer engines read, in one
 * place, so no page can quietly ship without a canonical or a description.
 *
 * The organisation graph is emitted on every page rather than only the
 * homepage: AI crawlers frequently fetch a single deep URL and never see the
 * root, so entity facts have to travel with the page that gets cited.
 */
interface Props {
  title: string;
  description: string;
  /** omit to use the site default OG image */
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  noindex?: boolean;
  /** page-specific JSON-LD appended to the organisation graph */
  schema?: Record<string, unknown>[];
  breadcrumbs?: { name: string; href: string }[];
}

const {
  title,
  description,
  image = site.ogImage,
  type = 'website',
  publishedTime,
  modifiedTime,
  author,
  noindex = false,
  schema = [],
  breadcrumbs = [],
} = Astro.props;

/**
 * `build.format: 'file'` writes /about.html, so Astro.url.pathname carries the
 * extension during the build. The canonical has to be the URL the host
 * actually serves — /about — or every page would declare a canonical that
 * differs from the one Google crawls.
 */
const cleanPath =
  Astro.url.pathname
    .replace(/index\.html$/, '')
    .replace(/\.html$/, '')
    .replace(/\/+$/, '') || '/';

const canonical = new URL(cleanPath, site.url).href;
const ogImage = new URL(image, site.url).href;
/**
 * The brand suffix is dropped when the authored title is already long enough
 * to be at risk of truncation. Several service and article titles are written
 * to a deliberate length in the content files; appending ' — Gobiya' to a
 * 90-character title only guarantees the brand is the part Google cuts off.
 */
const SUFFIX_BUDGET = 52;
const fullTitle =
  title.includes(brand.name) || title.length > SUFFIX_BUDGET
    ? title
    : `${title} — ${brand.name}`;

const organisation = {
  '@type': 'ProfessionalService',
  '@id': `${site.url}/#organization`,
  name: brand.name,
  legalName: brand.legalName,
  url: site.url,
  email: brand.email,
  telephone: brand.phone,
  foundingDate: brand.founded,
  description: site.defaultDescription,
  address: {
    '@type': 'PostalAddress',
    addressLocality: brand.locality,
    addressRegion: brand.region,
    postalCode: brand.postalCode,
    addressCountry: brand.country,
  },
  areaServed: {
    '@type': 'AdministrativeArea',
    name: 'Southern California',
  },
  priceRange: '$$',
};

const website = {
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  url: site.url,
  name: brand.name,
  publisher: { '@id': `${site.url}/#organization` },
  inLanguage: 'en-US',
};

const breadcrumbGraph =
  breadcrumbs.length > 0
    ? [
        {
          '@type': 'BreadcrumbList',
          itemListElement: breadcrumbs.map((crumb, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            name: crumb.name,
            item: new URL(crumb.href, site.url).href,
          })),
        },
      ]
    : [];

const graph = {
  '@context': 'https://schema.org',
  '@graph': [organisation, website, ...breadcrumbGraph, ...schema],
};
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{noindex
  ? <meta name="robots" content="noindex, follow" />
  : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={brand.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{author && <meta property="article:author" content={author} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<script type="application/ld+json" set:html={JSON.stringify(graph)} is:inline />
